# Non-rahasia. Salin ke deploy/.env (mode 600, owner deploy) di VPS dan isi
# nilai aslinya. Jangan pernah commit deploy/.env.
DOMAIN=absensi.example.com
ACME_EMAIL=admin@example.com

IMAGE_TAG=latest
APP_ENV=production
LOG_LEVEL=info

POSTGRES_DB=absensi
POSTGRES_USER=absensi_owner
POSTGRES_PASSWORD=change-me-owner
ABSENSI_APP_PASSWORD=change-me-app

# URL-encode special characters in passwords when building these URLs.
DATABASE_URL=postgres://absensi_app:change-me-app@postgres:5432/absensi?sslmode=disable
MIGRATE_DATABASE_URL=postgres://absensi_owner:change-me-owner@postgres:5432/absensi?sslmode=disable

SMOKE_URL=https://absensi.example.com
BACKUP_RETENTION_DAYS=30
# Optional: rclone remote, e.g. r2:absensi-backups
RCLONE_REMOTE=
